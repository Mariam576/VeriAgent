# Copy this file to ".env" and fill in the values. Never commit the real .env file.

# ---------------------------------------------------------------- LLM provider
# gemini | grok | mock
#   mock = offline rule-based stand-in. No API key, no cost. Good for tests and
#          for watching the whole pipeline run before you have a key.
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any text model your key can use. Check https://ai.google.dev/gemini-api/docs/models
# for current names (the Flash / Flash-Lite models are the cheap ones).
GEMINI_MODEL=gemini-3.1-flash-lite

GROK_API_KEY=
GROK_MODEL=
GROK_BASE_URL=https://api.x.ai/v1

# Optional: provider to try when the main one keeps failing (logged, never silent).
LLM_FALLBACK_PROVIDER=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Leave empty to use the provider's own default temperature.
LLM_TEMPERATURE=
# Free tiers limit requests per minute. 0 = no limit. Try 10 if you hit rate-limit errors.
LLM_REQUESTS_PER_MINUTE=0

# -------------------------------------------------------------------- Database
# Docker Compose sets the right value for the api container by itself.
# This line is used when you run the API directly on your PC (outside Docker):
# the database container is then reachable on localhost, port DB_PORT.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/veriagent

# Ports on your PC (Docker Compose only). Change them if a port is already in use.
API_PORT=8000
DB_PORT=5433

# ------------------------------------------------------------------ Embeddings
# local  = free SentenceTransformer model that runs on your machine (default)
# gemini = Gemini embedding API (uses GEMINI_API_KEY)
# hash   = offline keyword hashing, for tests only
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the model: all-MiniLM-L6-v2 = 384. The database column is created with this size.
EMBEDDING_DIM=384

# ------------------------------------------------------------------------- RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=8
RERANK_TOP_K=4
MAX_RETRIEVED_CHUNKS=12
# Hybrid search adds keyword matching to vector search, so exact codes such as
# INV-129 or "Clause 7.3" are found reliably. KEYWORD_TOP_K = keyword candidates per query.
HYBRID_SEARCH=true
KEYWORD_TOP_K=8

# ----------------------------------------------------------------------- Agent
MAX_AGENT_ITERATIONS=6
# true  = an investigation that needs a human decision pauses until someone
#         approves, rejects or modifies it (POST /investigations/{id}/approve)
# false = it never pauses; the report only says that a person should look at it
ENABLE_HUMAN_APPROVAL=true
# Keep the saved graph state of finished investigations (for debugging). Default: delete it.
KEEP_CHECKPOINTS=false
# A run without progress for this many seconds may be continued with POST /investigations/{id}/resume
STALE_RUN_SECONDS=300

# -------------------------------------------------------------------- Uploads
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
UPLOAD_DIR=uploads

LOG_LEVEL=INFO

# ---------------------------------------------------------------- Tracing
# Every investigation is traced into the database (GET /investigations/{id}/trace).
# Optional: also send traces to LangSmith. LangChain reads these by itself;
# no application code depends on them.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=veriagent
