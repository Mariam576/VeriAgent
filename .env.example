# Copy this file to ".env" and fill in the values. Never commit the real .env file.

# ---------------------------------------------------------------- LLM provider
# gemini | grok | mock
#   mock = offline rule-based stand-in. No API key, no cost. Good for tests and
#          for watching the whole pipeline run before you have a key.
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any text model your key can use. Check https://ai.google.dev/gemini-api/docs/models
# for current names (the Flash / Flash-Lite models are the cheap ones).
GEMINI_MODEL=gemini-3.1-flash-lite

GROK_API_KEY=
GROK_MODEL=
GROK_BASE_URL=https://api.x.ai/v1

# Optional: provider to try when the main one keeps failing (logged, never silent).
LLM_FALLBACK_PROVIDER=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Leave empty to use the provider's own default temperature.
LLM_TEMPERATURE=
# Free tiers limit requests per minute. 0 = no limit. Try 10 if you hit rate-limit errors.
LLM_REQUESTS_PER_MINUTE=0

# -------------------------------------------------------------------- Database
# Docker Compose sets the right value for the api container by itself.
# This line is used when something on your PC talks to the database directly
# (a database viewer, or the API started outside Docker on Linux or macOS):
# the database container is then reachable on localhost, port DB_PORT.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/veriagent

# Ports on your PC (Docker Compose only). Change them if a port is already in use.
API_PORT=8000
DB_PORT=5433
UI_PORT=8501

# ------------------------------------------------------------------ Embeddings
# local  = free SentenceTransformer model that runs on your machine (default)
# gemini = Gemini embedding API (uses GEMINI_API_KEY)
# hash   = offline keyword hashing, for tests only
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the model: all-MiniLM-L6-v2 = 384. The database column is created with this size.
EMBEDDING_DIM=384

# ------------------------------------------------------------------------- RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=8
RERANK_TOP_K=4
MAX_RETRIEVED_CHUNKS=12
# Hybrid search adds keyword matching to vector search, so exact codes such as
# INV-129 or "Clause 7.3" are found reliably. KEYWORD_TOP_K = keyword candidates per query.
HYBRID_SEARCH=true
KEYWORD_TOP_K=8

# ----------------------------------------------------------------------- Agent
MAX_AGENT_ITERATIONS=6
# true  = an investigation that needs a human decision pauses until someone
#         approves, rejects or modifies it (POST /investigations/{id}/approve)
# false = it never pauses; the report only says that a person should look at it
ENABLE_HUMAN_APPROVAL=true
# Keep the saved graph state of finished investigations (for debugging). Default: delete it.
KEEP_CHECKPOINTS=false
# A run without progress for this many seconds may be continued with POST /investigations/{id}/resume
STALE_RUN_SECONDS=300
# An investigation that is still unfinished after this many days (nobody decided or
# resumed it) is closed as failed and its saved state is deleted. 0 = never.
CHECKPOINT_TTL_DAYS=30

# -------------------------------------------------------------------- Sign-in
# jwt = people sign in with email and password (or Google). Use this.
# dev = the X-User-Id header is trusted without proof. Tests and experiments only.
AUTH_MODE=jwt
# Signs the access tokens. Leave it empty and VeriAgent creates a key itself and keeps
# it in the database. If you set it, use at least 32 random characters.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
# Google sign-in: create an OAuth client id (type "Web application") in the Google Cloud
# console, add your site's address under "Authorized JavaScript origins", and paste the
# client id here. Empty = the Google button is not shown.
GOOGLE_CLIENT_ID=
# false = nobody new can create an account (people who have one can still sign in).
ALLOW_REGISTRATION=true
# If set, creating an account needs this code. Use it on a public deployment, so that
# strangers cannot register and spend your Gemini quota.
SIGNUP_CODE=
# Most investigations one account may start in 24 hours. 0 = no limit.
MAX_INVESTIGATIONS_PER_DAY=0
# true only behind a proxy you trust (Render sets the client's address in X-Forwarded-For).
TRUST_PROXY_HEADERS=false

# --------------------------------------------------------------------- Memory
# Long-term memory: preferences (key/value) and notes about finished investigations.
ENABLE_MEMORY=true
# How many earlier notes may be shown with a new investigation.
MEMORY_TOP_K=3
# Minimum cosine similarity (0..1) for a note to count as related. The right value
# depends on the embedding model: raise it if unrelated notes show up, lower it if
# related ones are missed.
MEMORY_MIN_SIMILARITY=0.3

# -------------------------------------------------------------------- Uploads
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
UPLOAD_DIR=uploads

LOG_LEVEL=INFO

# ---------------------------------------------------------------- Tracing
# Every investigation is traced into the database (GET /investigations/{id}/trace).
# Optional: also send traces to LangSmith. LangChain reads these by itself;
# no application code depends on them.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=veriagent
